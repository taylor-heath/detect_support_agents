{
  "name": "document-readonly-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Strictly read-only MCP server adapting the Document Service API for MCP hosts",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "document-mcp-stdio": "./dist/bin/stdio.js",
    "document-mcp-http": "./dist/bin/http.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:stdio": "node dist/bin/stdio.js",
    "start:http": "node dist/bin/http.js",
    "dev:stdio": "tsx src/bin/stdio.ts",
    "dev:http": "tsx src/bin/http.ts",
    "test": "vitest run",
    "check:readonly": "node scripts/check-readonly.mjs",
    "check:openapi": "node scripts/check-openapi.mjs",
    "verify": "npm run check:openapi && npm run check:readonly && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "jose": "^6.2.10",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@readme/openapi-parser": "^5.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "yaml": "^2.8.1"
  }
}
