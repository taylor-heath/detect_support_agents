# Document read-only MCP server — environment template.
# Copy this file to .env for local runs. Nothing here holds a real credential:
# values are injected from your secrets manager at deploy time (contract §8).

# ── Upstream Document API ────────────────────────────────────────────────────
# Base URL including the version path.
DOCS_API_BASE_URL=https://api.example.com/v1

# ── Keycloak realm ───────────────────────────────────────────────────────────
# Realm issuer. JWKS and token endpoints are derived from it unless overridden.
DOCS_MCP_ISSUER_URL=https://auth.example.com/realms/docs
# DOCS_MCP_JWKS_URI       — override the derived JWKS endpoint
# DOCS_MCP_TOKEN_ENDPOINT — override the derived token endpoint
# DOCS_MCP_AUDIENCE       — expected `aud` of inbound tokens; unset skips the check
# DOCS_MCP_IGNORED_SCOPES — space-separated scopes that carry no capability;
#                           default "openid profile email offline_access".
#                           Any other scope on a token is refused with 403.

# ── Streamable HTTP transport ────────────────────────────────────────────────
# The URL the host is configured with, verbatim. The RFC 9728 metadata
# document's `resource` field must match this exactly, path included.
DOCS_MCP_RESOURCE_URL=https://mcp.example.com/mcp
# DOCS_MCP_HOST — default 0.0.0.0
# DOCS_MCP_PORT — default 3000
# DOCS_MCP_PATH — default /mcp

# ── Outbound credential ──────────────────────────────────────────────────────
# forward  — pass the caller's verified token upstream unchanged (default)
# exchange — RFC 8693 exchange for a token scoped to the API audience
DOCS_MCP_OUTBOUND_TOKEN_MODE=forward
# DOCS_MCP_CLIENT_ID     — required for `exchange`, and for stdio
# DOCS_MCP_CLIENT_SECRET — injected at deploy time; never committed
# DOCS_API_AUDIENCE      — required for `exchange`

# ── Logging ──────────────────────────────────────────────────────────────────
# DOCS_MCP_LOG_LEVEL — debug | info | warn | error (default info)

# ── Note on loading this file ────────────────────────────────────────────────
# Nothing reads .env automatically. The npm start:* and dev:* scripts pass
# Node's --env-file-if-exists=.env for you; a bare `node dist/bin/http.js`
# does not. In production, inject these as real environment variables.
